<t t-name="warehouse_bulk_pick_template">
  <t t-call="web.html_container">

    <t t-set="company" t-value="docs and docs[0].order_id.company_id or res_company"/>

    <div class="page" style="font-size: 13px;">

      <!-- Header -->
      <div style="width: 100%; margin-bottom: 15px; display: table;">
        <div style="display: table-cell; width: 80px; vertical-align: middle;">
          <img t-if="company.logo" t-att-src="image_data_uri(company.logo)" style="max-height: 70px; max-width: 70px;"/>
        </div>

        <div style="display: table-cell; vertical-align: middle;">
          <h2 style="margin: 0;">SCUSD - CK</h2>
        </div>
      </div>

      <h3>Warehouse Bulk Pick Worksheet</h3>

      <t t-if="not docs">
        <p>No records selected.</p>
      </t>

      <t t-if="docs">

        <!-- Delivery dates from selected sales order lines -->
        <t t-set="dates" t-value="sorted(set(line.order_id.x_studio_delivery_date for line in docs if line.order_id.x_studio_delivery_date))"/>

        <t t-foreach="dates" t-as="delivery_date">

          <h4>Delivery Date: <span t-esc="delivery_date"/></h4>

          <t t-set="date_lines" t-value="docs.filtered(lambda l: l.order_id.x_studio_delivery_date and l.order_id.x_studio_delivery_date == delivery_date)"/>

          <!-- Unique products for this delivery date -->
          <t t-set="products" t-value="date_lines.mapped('product_id').sorted(lambda p: p.default_code or '')"/>

          <table style="width: 100%; border-collapse: collapse; table-layout: fixed; margin-bottom: 25px;">
            <thead>
              <tr style="background-color: #f2f2f2;">
                <th style="width: 18%; border: 1px solid #777; padding: 6px; text-align: left;">Location</th>
                <th style="width: 12%; border: 1px solid #777; padding: 6px; text-align: left;">Item Code</th>
                <th style="width: 32%; border: 1px solid #777; padding: 6px; text-align: left;">Item Description</th>
                <th style="width: 8%; border: 1px solid #777; padding: 6px; text-align: left;">QTY</th>
                <th style="width: 10%; border: 1px solid #777; padding: 6px; text-align: left;">Pack Size</th>
                <th style="width: 20%; border: 1px solid #777; padding: 6px; text-align: left;">Lot Number</th>
              </tr>
            </thead>

            <tbody>
              <t t-foreach="products" t-as="product">
            
                <t t-set="product_lines" t-value="date_lines.filtered(lambda l: l.product_id.id == product.id)"/>
                <t t-set="total_qty" t-value="sum(line.product_uom_qty or 0 for line in product_lines)"/>
                <t t-set="remaining_qty" t-value="total_qty"/>
                <t t-set="row_count" t-value="0"/>
            
                <t t-set="lots" t-value="env['stock.lot'].search([                   ('product_id', '=', product.id),                   ('quant_ids.available_quantity', '&gt;', 0),                   ('quant_ids.location_id.usage', '=', 'internal'),                   ('expiration_date', '!=', False)                 ], order='expiration_date asc')"/>
            
                <t t-foreach="lots" t-as="lot">
                  <t t-if="remaining_qty &gt; 0">
            
                    <t t-set="lot_quants" t-value="env['stock.quant'].search([                       ('product_id', '=', product.id),                       ('lot_id', '=', lot.id),                       ('available_quantity', '&gt;', 0),                       ('location_id.usage', '=', 'internal')                     ])"/>
            
                    <t t-set="ordered_quants" t-value="sorted(lot_quants, key=lambda q: (                          int(((q.location_id.complete_name or '').split('-')[2]).replace('C','')) if len((q.location_id.complete_name or '').split('-')) &gt; 2 and ((q.location_id.complete_name or '').split('-')[2]).replace('C','').isdigit() else 999,                          {'R1': 1, 'R2': 2, 'R3': 3}.get((q.location_id.complete_name or '').split('-')[1], 99) if len((q.location_id.complete_name or '').split('-')) &gt; 1 else 99,                          {'F': 1, 'B': 2}.get((q.location_id.complete_name or '').split('-')[3], 99) if len((q.location_id.complete_name or '').split('-')) &gt; 3 else 99                        ))"/>
            
                    <t t-foreach="ordered_quants" t-as="q">
                      <t t-if="remaining_qty &gt; 0">
            
                        <t t-set="pick_qty" t-value="q.available_quantity if q.available_quantity &lt;= remaining_qty else remaining_qty"/>
            
                        <tr t-att-style="'background-color: #f7f7f7;' if row_count &gt; 0 else ''">
            
                          <td style="border: 1px solid #777; padding: 8px; font-size: 14px; text-align: center; vertical-align: middle;">
                            <span t-esc="q.location_id.complete_name.split('/')[-1][:2] + q.location_id.complete_name.split('/')[-1][2:]"/>
                            <br/>
                            <span t-if="q.location_id.barcode" t-field="q.location_id.barcode" t-options="{'widget': 'barcode', 'symbology': 'Code128', 'width': 300, 'height': 80, 'img_style': 'width:130px;height:35px;'}"/>
                          </td>
            
                          <td style="border: 1px solid #777; padding: 8px;">
                            <span t-esc="product.default_code or ''"/>
                          </td>
            
                          <td style="border: 1px solid #777; padding: 8px;">

                              <span t-esc="product.display_name"/>
                            
                              <t t-if="row_count &gt; 0">
                                <br/>
                                <span style="font-size: 11px; font-style: italic; color: #C30010;">
                                  The previous location did not have enough inventory to fulfill this order.
                                  This additional location was selected to complete the remaining quantity
                                  for this item.
                                </span>
                              </t>
                            
                          </td>
            
                          <td style="border: 1px solid #777; padding: 8px;">
                            <span t-esc="'%g' % pick_qty"/>
                          </td>
            
                          <td style="border: 1px solid #777; padding: 8px;">
                            <span t-esc="product.uom_id.name or ''"/>
                          </td>
            
                          <td style="border: 1px solid #777; padding: 8px; font-size: 14px; text-align: center; vertical-align: middle;">
                            <span t-esc="lot.name"/>
                            <br/>
                            <span t-field="lot.name" t-options="{'widget': 'barcode', 'symbology': 'Code128', 'width': 300, 'height': 80, 'img_style': 'width:130px;height:35px;'}"/>
                          </td>
            
                        </tr>
            
                        <t t-set="remaining_qty" t-value="remaining_qty - pick_qty"/>
                        <t t-set="row_count" t-value="row_count + 1"/>
            
                      </t>
                    </t>
            
                  </t>
                </t>
            
              </t>
            </tbody>
          </table>

        </t>
      </t>

    </div>
  </t>
</t>