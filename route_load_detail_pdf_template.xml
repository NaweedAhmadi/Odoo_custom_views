<t t-name="route_load_detail_pdf_template">
  <t t-call="web.html_container">
      
      <t t-set="company" t-value="docs and docs[0].order_id.company_id or res_company"/>

        <div style="width: 100%; margin-bottom: 15px; display: table;">
          <div style="display: table-cell; width: 80px; vertical-align: middle;">
            <img t-if="company.logo" t-att-src="image_data_uri(company.logo)" style="max-height: 70px; max-width: 70px;"/>
          </div>
        
          <div style="display: table-cell; vertical-align: middle;">
            <h2 style="margin: 0;">
              <span t-esc="company.name"/>
            </h2>
          </div>
        </div>
        
    <div class="page">

      <h2 style="margin-bottom: 1px;">Route Load Detail Report</h2>

      <t t-if="not docs">
        <p>No records selected.</p>
      </t>

      <t t-if="docs">
        <t t-set="dates" t-value="sorted(set(line.order_id.x_studio_delivery_date for line in docs if line.order_id.x_studio_delivery_date))"/>

        <t t-foreach="dates" t-as="report_date">
          <h3 style="margin-top: 20px;">Delivery Date: <span t-esc="report_date"/></h3>

          <t t-set="date_lines" t-value="docs.filtered(lambda l: l.order_id.x_studio_delivery_date and l.order_id.x_studio_delivery_date == report_date)"/>
          <t t-set="routes" t-value="sorted(set(line.x_studio_route for line in date_lines if line.x_studio_route))"/>

          <t t-foreach="routes" t-as="route">
            <h4 style="margin-top: 15px;">Route <span t-esc="route"/></h4>

            <t t-set="route_lines" t-value="date_lines.filtered(lambda l: l.x_studio_route == route)"/>
            <t t-set="sites" t-value="sorted(set(line.order_partner_id.name for line in route_lines if line.order_partner_id))"/>

            <table style="width: 100%; border-collapse: collapse; margin-bottom: 25px; table-layout: fixed;">
              <thead>
                <tr style="background-color: #f2f2f2;">
                  <th style="width: 55%; border: 1px solid #999; padding: 8px; text-align: left;">Site</th>
                  <th style="width: 15%; border: 1px solid #999; padding: 8px; text-align: right;">Total Weight</th>
                  <th style="width: 15%; border: 1px solid #999; padding: 8px; text-align: right;">Total Cases</th>
                  <th style="width: 15%; border: 1px solid #999; padding: 8px; text-align: right;">Total Units</th>
                </tr>
              </thead>

              <tbody>
                <t t-set="sites" t-value="route_lines.sorted(lambda l: l.x_studio_stop or 0).mapped('order_partner_id')"/>

                <t t-foreach="sites" t-as="site">
                  <t t-set="site_lines" t-value="route_lines.filtered(lambda l: l.order_partner_id.id == site.id)"/>
                
                  <t t-set="site_weight" t-value="sum(line.x_studio_line_total_weight or 0 for line in site_lines)"/>
                  <t t-set="site_cases" t-value="sum(line.product_uom_qty or 0 for line in site_lines if line.product_uom and line.product_uom.name.lower() in ['case', 'cases'])"/>
                  <t t-set="site_units" t-value="sum(line.product_uom_qty or 0 for line in site_lines if line.product_uom and line.product_uom.name.lower() in ['unit', 'units', 'each'])"/>
                
                  <tr>
                    <td style="border: 1px solid #999; padding: 8px;">
                      <span t-esc="site.name"/>
                    </td>
                    <td style="border: 1px solid #999; padding: 8px; text-align: right;">
                      <span t-esc="round(site_weight, 2)"/>
                    </td>
                    <td style="border: 1px solid #999; padding: 8px; text-align: right;">
                      <span t-esc="site_cases"/>
                    </td>
                    <td style="border: 1px solid #999; padding: 8px; text-align: right;">
                      <span t-esc="site_units"/>
                    </td>
                  </tr>
                </t>

                <t t-set="route_weight" t-value="sum(line.x_studio_line_total_weight or 0 for line in route_lines)"/>
                <t t-set="route_cases" t-value="sum(line.product_uom_qty or 0 for line in route_lines if line.product_uom and line.product_uom.name.lower() in ['case', 'cases'])"/>
                <t t-set="route_units" t-value="sum(line.product_uom_qty or 0 for line in route_lines if line.product_uom and line.product_uom.name.lower() in ['unit', 'units', 'each'])"/>

                <tr style="font-weight: bold; background-color: #f8f8f8;">
                  <td style="border: 1px solid #999; padding: 8px;">
                    Route <span t-esc="route"/> Total
                  </td>
                  <td style="border: 1px solid #999; padding: 8px; text-align: right;">
                    <span t-esc="round(route_weight, 2)"/>
                  </td>
                  <td style="border: 1px solid #999; padding: 8px; text-align: right;">
                    <span t-esc="route_cases"/>
                  </td>
                  <td style="border: 1px solid #999; padding: 8px; text-align: right;">
                    <span t-esc="route_units"/>
                  </td>
                </tr>
              </tbody>
            </table>
          </t>
        </t>
      </t>
    </div>
  </t>
</t>