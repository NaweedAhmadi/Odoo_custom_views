<t t-name="warehouse_receiving_worksheet_template">
  <t t-call="web.html_container">

    <t t-foreach="docs" t-as="o">
      <t t-set="company" t-value="o.company_id or res_company"/>
      
      <div style="width: 100%; margin-bottom: 15px; display: table;">
          <div style="display: table-cell; width: 80px; vertical-align: middle;">
            <img t-if="company.logo" t-att-src="image_data_uri(company.logo)" style="max-height: 70px; max-width: 70px;"/>
          </div>
        
          <div style="display: table-cell; vertical-align: middle;">
            <h2 style="margin: 0;">
              <span t-esc="company.name"/>
            </h2>
          </div>
        </div>

      <div class="page" style="font-size: 13px;">
        <h2 style="margin-bottom: 15px;">
          <span>Warehouse Receiving Worksheet - </span>
          <t t-if="o.backorder_id">
            <span style="font-weight: bold; background-color: #ffff00;">
              BACKORDER
            </span>
          </t>
        </h2>

        <!-- Receipt Number + Barcode -->
        <table style="width: 100%; margin-bottom: 20px;">
          <tr>
            
            <td style="font-size: 40px; width: 220px; vertical-align: middle;">
              <span t-esc="o.name"/>
            </td>
        
            <td style="vertical-align: middle; text-align: left;">
              <span t-field="o.name" t-options="{'widget': 'barcode', 'symbology': 'Code128', 'width': 600, 'height': 100, 'img_style': 'width:220px;height:45px;'}"/>
            </td>
        
          </tr>
        </table>

        <!-- Receiving Info -->
        <table style="width: 100%; border-collapse: collapse; margin-bottom: 25px;">
          <tr>
            <td style="width: 20%; border: 1px solid #777; padding: 6px; font-weight: bold;">PO Number</td>
            <td style="width: 30%; border: 1px solid #777; padding: 6px;">
              <span t-esc="o.origin or ''"/>
            </td>

            <td style="width: 20%; border: 1px solid #777; padding: 6px; font-weight: bold;">Seal Intact</td>
    
            <td style="width: 30%; border: 1px solid #777; padding: 6px;">
              <span style="display:inline-block; width:12px; height:12px; border:1px solid black; margin-right:5px; vertical-align:middle;"/>
              <span>Yes</span>
            
              <span style="margin-left:20px;"/>
            
              <span style="display:inline-block; width:12px; height:12px; border:1px solid black; margin-right:5px; vertical-align:middle;"/>
              <span>No</span>
            </td>
          </tr>

          <tr>
            <td style="border: 1px solid #777; padding: 6px; font-weight: bold;">Vendor</td>
            <td style="border: 1px solid #777; padding: 6px;">
              <span t-esc="o.partner_id.name or ''"/>
            </td>

            <td style="border: 1px solid #777; padding: 6px; font-weight: bold;">Trailer Clean</td>
            
            <td style="border: 1px solid #777; padding: 6px;">
              <span style="display:inline-block; width:12px; height:12px; border:1px solid black; margin-right:5px; vertical-align:middle;"/>
              <span>Yes</span>
            
              <span style="margin-left:20px;"/>
            
              <span style="display:inline-block; width:12px; height:12px; border:1px solid black; margin-right:5px; vertical-align:middle;"/>
              <span>No</span>
            </td>
            
          </tr>

          <tr>
            <td style="border: 1px solid #777; padding: 6px; font-weight: bold;">Delivery Date</td>
            <td style="border: 1px solid #777; padding: 6px;">
              <span t-esc="o.scheduled_date.strftime('%m-%d-%Y') if o.scheduled_date else ''"/>
            </td>

            <td style="border: 1px solid #777; padding: 6px; font-weight: bold;">Refer Temperature</td>
            <td style="border: 1px solid #777; padding: 6px;"/>
          </tr>

          <tr>
            <td style="border: 1px solid #777; padding: 6px; font-weight: bold;">Arrival Time</td>
            <td style="border: 1px solid #777; padding: 6px;"/>

            <td style="border: 1px solid #777; padding: 6px; font-weight: bold;">Receiver Name</td>
            <td style="border: 1px solid #777; padding: 6px;"/>
          </tr>
        </table>

        <!-- Product Lines -->
        <table style="width: 100%; border-collapse: collapse; table-layout: fixed; font-size: 13px;">
          <thead>
            <tr style="background-color: #d9d9d9;">
              <th style="width: 26%; border: 1px solid #777; padding: 6px; text-align: left; word-wrap: break-word; overflow-wrap: break-word; white-space: normal;">Description</th>
              <th style="width: 10%; border: 1px solid #777; padding: 6px; text-align: left; word-wrap: break-word; overflow-wrap: break-word; white-space: normal;">MFG Code</th>
              <th style="width: 10%; border: 1px solid #777; padding: 6px; text-align: left;">CK Market</th>
              <th style="width: 9%; border: 1px solid #777; padding: 6px; text-align: left;">Pack Size</th>
              <th style="width: 9%; border: 1px solid #777; padding: 6px; text-align: left;">Ordered Qty</th>
              <th style="width: 18%; border: 1px solid #777; padding: 6px; text-align: left;">Expiration Date</th>
              <th style="width: 9%; border: 1px solid #777; padding: 6px; text-align: left;">Cases / Pallets</th>
              <th style="width: 9%; border: 1px solid #777; padding: 6px; text-align: left;">Product Temp</th>
            </tr>
          </thead>

          <tbody>
            <t t-foreach="o.move_ids_without_package" t-as="line">
              <tr>
                <td style="border: 1px solid #777; padding: 10px; height: 40px; word-wrap: break-word; overflow-wrap: break-word; white-space: normal; vertical-align: top;">
                  <!--<span t-esc="line.purchase_line_id.name or line.name or line.product_id.display_name"/>-->
                  <span t-esc="                     '[%s] %s' % (                     (                     line.product_id.seller_ids.filtered(lambda s: s.partner_id == o.partner_id)[:1].product_code                     or line.product_id.default_code                     ),                     line.product_id.name                     )                   "/>
                </td>

                <td style="border: 1px solid #777; padding: 10px; word-wrap: break-word; overflow-wrap: break-word; white-space: normal; vertical-align: top;">
                  <!-- Replace this field if your MFG code is stored in a custom field -->
                  <span t-esc="line.product_id.x_studio_mfg_code or ''"/>
                </td>

                <td style="border: 1px solid #777; padding: 10px; vertical-align: top;">
                  <span t-esc="line.product_id.default_code or ''"/>
                </td>

                <td style="border: 1px solid #777; padding: 10px; vertical-align: top;">
                  <!-- Replace with your pack size custom field if needed -->
                  <span t-esc="line.product_id.uom_id.name or ''"/>
                </td>

                <td style="border: 1px solid #777; padding: 10px; vertical-align: top;">

                  <t t-if="line.purchase_line_id and line.purchase_line_id.product_uom">
                
                    <t t-set="po_uom" t-value="line.purchase_line_id.product_uom"/>
                    <t t-set="stock_uom" t-value="line.product_uom"/>
                
                    <!-- Convert stock quantity back into PO UoM -->
                    <t t-set="po_qty" t-value="stock_uom._compute_quantity(line.product_uom_qty, po_uom)"/>
                
                    <strong>
                      <span t-esc="'%g' % po_qty"/>
                      <span t-esc="po_uom.name.split(' of ')[0]"/>
                    </strong>
                
                    <t t-if="po_uom != stock_uom">
                      <br/>
                      <span style="font-size: 11px;">
                        (<span t-esc="'%g' % line.product_uom_qty"/>
                        <span t-esc="stock_uom.name"/>)
                      </span>
                    </t>
                
                  </t>
                
                  <t t-else="">
                    <span t-esc="'%g' % line.product_uom_qty"/>
                    <span t-esc="line.product_uom.name"/>
                  </t>
                
                </td>

                <td style="border: 1px solid #777; padding: 10px; vertical-align: top;"/>
                <td style="border: 1px solid #777; padding: 10px; vertical-align: top;"/>
                <td style="border: 1px solid #777; padding: 10px; vertical-align: top;"/>
              </tr>

              <t t-if="not (line.product_id.default_code and (line.product_id.default_code.startswith('61') or line.product_id.default_code.startswith('62')))">

              <!-- Blank rows for handwriting -->
              <t t-foreach="[1,2]" t-as="i">
                <tr>
                  <td style="border: 1px solid #777; padding: 10px; height: 30px;"/>
                  <td style="border: 1px solid #777; padding: 10px;"/>
                  <td style="border: 1px solid #777; padding: 10px;"/>
                  <td style="border: 1px solid #777; padding: 10px;"/>
                  <td style="border: 1px solid #777; padding: 10px;"/>
                  <td style="border: 1px solid #777; padding: 10px;"/>
                  <td style="border: 1px solid #777; padding: 10px;"/>
                  <td style="border: 1px solid #777; padding: 10px;"/>
                </tr>
              </t>
            
            </t>
            </t>
          </tbody>
        </table>
        
        <!-- PUTAWAY Section -->
        <table style="width: 100%; border-collapse: collapse; margin-top: 18px; font-size: 13px;">
        
          <!-- Section Header -->
          <tr>
            <td colspan="4"
                style="border: 1px solid #777;
                       background-color: #d9d9d9;
                       padding: 7px;
                       font-weight: bold;
                       font-size: 14px;">
              PUTAWAY
            </td>
          </tr>
        
          <!-- Ready for Putaway / Total Pallets -->
          <tr>
            <td style="width: 22%;
                       border: 1px solid #777;
                       padding: 8px;
                       font-weight: bold;">
              Ready for Putaway
            </td>
        
            <td style="width: 28%;
                       border: 1px solid #777;
                       padding: 8px;">
              <span style="display:inline-block;
                           width:12px;
                           height:12px;
                           border:1px solid black;
                           margin-right:6px;
                           vertical-align:middle;"/>
              <span>Yes</span>
            </td>
        
            <td style="width: 22%;
                       border: 1px solid #777;
                       padding: 8px;
                       font-weight: bold;">
              Total Pallets
            </td>
        
            <td style="width: 28%;
                       border: 1px solid #777;
                       padding: 8px;">
            </td>
          </tr>
        
          <!-- Putaway Completed / Initials -->
          <tr>
            <td style="border: 1px solid #777;
                       padding: 8px;
                       font-weight: bold;">
              Putaway Completed
            </td>
        
            <td style="border: 1px solid #777;
                       padding: 8px;">
              <span style="display:inline-block;
                           width:12px;
                           height:12px;
                           border:1px solid black;
                           margin-right:6px;
                           vertical-align:middle;"/>
              <span>Yes</span>
            </td>
        
            <td style="border: 1px solid #777;
                       padding: 8px;
                       font-weight: bold;">
              Putaway By (Initials)
            </td>
        
            <td style="border: 1px solid #777;
                       padding: 8px;">
            </td>
          </tr>
        
        </table>

      </div>
    </t>
  </t>
</t>
